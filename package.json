{
  "name": "@sandsoftwaresolutions/mini-template",
  "version": "0.1.1",
  "description": "Fill in {{placeholders}} with HTML escaping, filters and errors for missing values. No loops, no code, no prototype tricks.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "template",
    "mustache",
    "placeholder",
    "email"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-mini-template.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-mini-template/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-mini-template#readme",
  "publishConfig": {
    "access": "public"
  }
}
